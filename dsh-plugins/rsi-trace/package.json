{
  "name": "@unreal-harness/rsi-trace",
  "description": "Discovery-tree trace and deterministic replay over a DeepSeek Harness session log",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neeboo/unreal-harness.git",
    "directory": "dsh-plugins/rsi-trace"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "rsi",
    "replay",
    "coding-agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.7-alpha.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
