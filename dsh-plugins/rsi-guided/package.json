{
  "name": "@deepseek-ai/dsh-rsi-guided",
  "description": "Trace-guided context: feed the recorded attempt ledger back into the agent's prompt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-alpha.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.2"
  }
}
